# Copy this file to .env and add your provider credentials.
# Keep .env private; never upload or commit it.
OPENAI_API_KEY=
# For DeepSeek OpenAI-compatible API, set:
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat
# For other OpenAI-compatible providers, use their documented base URL/model.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_AGENTS_DISABLE_TRACING=1
# Optional absolute SQLite path. Leave blank to use backend/data/career.db.
# CAREER_DB_PATH=C:/your/path/career.db
